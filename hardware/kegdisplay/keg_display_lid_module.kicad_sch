	(text "Keg Display LID Module - hosts the OLED + bi-color status LED.\nConnects to the main board (keg_display_module) via one 6-wire JST-PH cable - see ../README.md."
		(at 20 10 0)
		(effects
			(font
				(size 2 2)
			)
		)
		(uuid "31215a60-c7e7-4f72-aad5-c4eea06d5219")
	)
	(text "J2 = OLED module socket, pin order VCC/GND/SCL/SDA - CONFIRM against\nthe actual 0.91in SSD1306 module's own pin order before wiring.\nLED1 = bi-color LED, common cathode, no series resistors here (they\nstay on the main board, ahead of the cable)."
		(at 20 90 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8bcca224-e701-498e-9e91-5c6c26a849fa")
