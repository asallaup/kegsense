	(text "Keg Display Bar Module (rev 8) - off-the-shelf WS2812 strip glued/\nscrewed to the PCB front, NO MCU. KegStation drives the chain directly.\nSee ../README.md for the full revision history."
		(at 20 5 0)
		(effects
			(font
				(size 2 2)
			)
		)
		(uuid "de57a903-fe83-4ba8-8263-fb5d9bbc6218")
	)
	(text "J1 = chain in (box bottom-left), J2 = chain out (box bottom-right).\nTP1-3 = strip's bottom (IN) leads: GND/VCC/DIN, soldered by hand.\nTP4-6 = strip's top (OUT) leads: GND/VCC/DOUT, soldered by hand.\nOn the real PCB, TP6 (DOUT) is routed via the back copper layer down\nto J2 (see README). R1 = data-in series resistor. C1 = decoupling."
		(at 20 50 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f001b550-07fa-4ea3-b34a-7a6d5cd801b0")
	)
