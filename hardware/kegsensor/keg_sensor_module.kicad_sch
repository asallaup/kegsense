	(text "Keg Sensor Module - carrier for HX711 breakout + 4x half-bridge sensors + RJ11 to hub"
		(at 20 10 0)
		(effects
			(font
				(size 2 2)
			)
		)
		(uuid "ca13a287-07d2-4b12-afcd-dfee498c37ce")
	)
	(text "J1=FL J2=FR J3=BR J4=BL corner sensors.\nDiagonal pairing: J1+J3 -> SIG_POS, J2+J4 -> SIG_NEG.\nVerify against kit's wiring diagram - swap if reading is inverted/flat."
		(at 20 145 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1f8a687b-dc19-4d88-8744-f24855e26d17")
	)
	(text "J6 pin order (GND,DT,SCK,VCC) is a common HX711 module layout -\nCONFIRM against your specific module's silkscreen before wiring/routing."
		(at 130 130 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c9a62a6c-3aff-4f5a-96aa-f5bf32c0bf7b")
	)
	(text "J7 = RJ11 jack to in-keezer hub.\nPin1=GND(Black) Pin2=VCC(Red) Pin3=SCK(Green) Pin4=DT(Yellow).\nMust match hub-side RJ11 pin convention (wiring.md) for a straight-through cable.\nFootprint intentionally left blank - assign to match your exact RJ11 jack part."
		(at 220 40 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "025d57da-f158-43c3-9438-d7ff8ead14b0")
	)
